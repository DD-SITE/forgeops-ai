# ============================================
# Application
# ============================================

APP_ENV=development


# ============================================
# Frontend
# ============================================

NEXT_PUBLIC_API_URL=http://localhost:8000


# ============================================
# Backend
# ============================================

API_PORT=8000


# ============================================
# PostgreSQL
# ============================================

POSTGRES_DB=forgeops
POSTGRES_USER=forgeops
POSTGRES_PASSWORD=forgeops_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://forgeops:forgeops_dev_password@localhost:5432/forgeops


# ============================================
# Redis
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379

REDIS_URL=redis://localhost:6379/0


# ============================================
# AI
# ============================================

GEMINI_API_KEY=


# ============================================
# Authentication
# ============================================

CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=


# ============================================
# Object Storage
# ============================================

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=forgeops
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=forgeops-documents
S3_PRESIGNED_URL_EXPIRE_SECONDS=900

MINIO_CONSOLE_PORT=9001
S3_PORT=9000
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3000cd ~/forgeops-ai

EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

INGESTION_QUEUE_NAME=forgeops:ingestion
WORKER_POLL_TIMEOUT_SECONDS=5
WORKER_RECOVERY_INTERVAL_SECONDS=10
WORKER_STALE_JOB_SECONDS=600
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY_SECONDS=10
WORKER_CHUNK_BATCH_SIZE=64