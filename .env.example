# ============================================
# Application
# ============================================

APP_ENV=development


# ============================================
# Frontend
# ============================================

NEXT_PUBLIC_API_URL=http://localhost:8000


# ============================================
# Backend
# ============================================

API_PORT=8000


# ============================================
# PostgreSQL
# ============================================

POSTGRES_DB=forgeops
POSTGRES_USER=forgeops
POSTGRES_PASSWORD=forgeops_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://forgeops:forgeops_dev_password@localhost:5433/forgeops


# ============================================
# Redis
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379

REDIS_URL=redis://localhost:6379/0


# ============================================
# Authentication
# ============================================

CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000


# ============================================
# Gemini
# ============================================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash


# ============================================
# Object Storage - MinIO / S3
# ============================================

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=forgeops-documents
S3_PRESIGNED_URL_EXPIRE_SECONDS=900

MINIO_CONSOLE_PORT=9001
S3_PORT=9000
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3000


# ============================================
# Embeddings
# ============================================

EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384


# ============================================
# Ingestion Worker
# ============================================

INGESTION_QUEUE_NAME=forgeops:ingestion
WORKER_POLL_TIMEOUT_SECONDS=5
WORKER_RECOVERY_INTERVAL_SECONDS=10
WORKER_STALE_JOB_SECONDS=600
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY_SECONDS=10
WORKER_CHUNK_BATCH_SIZE=64


# ============================================
# Engineering Copilot / Agent
# ============================================

AGENT_MODEL=gemini-3.7-flash
AGENT_MAX_RETRIEVAL_CANDIDATES=30
AGENT_MAX_CONTEXT_CHUNKS=8
AGENT_THREAD_TTL_HOURS=168

# Optional encryption key for LangGraph checkpoints
LANGGRAPH_AES_KEY=


# ============================================
# GitHub Action Tool
# ============================================

GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_DEFAULT_REPOSITORY=


# ============================================
# Incident API Tool
# ============================================

INCIDENT_API_URL=
INCIDENT_API_TOKEN=


# ============================================
# API Hardening
# ============================================

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60


# ============================================
# Observability
# ============================================

OTEL_ENABLED=false
OTEL_SERVICE_NAME=forgeops-api
OTEL_EXPORTER_OTLP_ENDPOINT=

SENTRY_DSN=

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=